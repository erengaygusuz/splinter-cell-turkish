  "segments": [
    {
      "start": 0.0,
      "end": 3.76,
      "text": " İnanması zor, işimiz bitince kaçış yolun var mı?",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 4.06,
      "end": 8.94,
      "text": " Güzel, ark güvenceye alınana kadar Amerikalıları fazla öfkelen demek istemiyorum.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 9.1,
      "end": 10.98,
      "text": " Çabuk ol, burada fazla kalamazsın.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 11.36,
      "end": 16.78,
      "text": " Elbette, yaratıcılarının varlığını bile kabul edemediği bir silahın değerini küçümsediğimi sanma.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 17.12,
      "end": 20.72,
      "text": " Buyur, Nikoladze, ne de olsa humidor gir zamanlar senindi.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 21.16,
      "end": 23.18,
      "text": " Amerikalıları düşman edinmeye niyetim yok.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 23.64,
      "end": 27.22,
      "text": " Amerikalılara hiçbir zaman dostlarım demedim, sadece komşularım.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 27.58,
      "end": 29.66,
      "text": " Evet, anlaştık, paranı alacaksın.",
      "no_speech_prob": 0.20764568448066711
    },
    {
      "start": 29.66,
      "end": 34.66,
      "text": " Anlaştık. Sizinle olmak bir zevkti ama umarım bir daha karşılaşmayız.",
      "no_speech_prob": 0.0749467983841896
    }
  ],
