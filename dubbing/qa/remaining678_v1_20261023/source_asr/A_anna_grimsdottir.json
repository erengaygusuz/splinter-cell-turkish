  "segments": [
    {
      "start": 0.0,
      "end": 1.82,
      "text": " Sen Fischer olmalısın.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 2.02,
      "end": 3.3,
      "text": " Ben Anna Grimsdottir.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 3.46,
      "end": 4.94,
      "text": " Tanıştığımıza memnun oldum.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 5.2,
      "end": 6.3,
      "text": " Dersine çalışmışsın.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 6.7,
      "end": 8.4,
      "text": " Operasyon Uydu bağlantısı.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 8.7,
      "end": 11.16,
      "text": " Aslında milyonlarca dolarlık bir PDA.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 11.4,
      "end": 14.54,
      "text": " Görevlerini tamamlamak için bilmen gereken her şeyi gösterir.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 14.9,
      "end": 16.42,
      "text": " Ara yüze alıştığından emin ol.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 16.88,
      "end": 18.26,
      "text": " Kendini tanıtmana gerek yok.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 18.66,
      "end": 20.68,
      "text": " Lambert geçmişini yeterince anlattı.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 20.82,
      "end": 21.72,
      "text": " Tam tersine.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 22.0,
      "end": 23.84,
      "text": " Adam seni Aziz ilan etmek istiyor.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 24.18,
      "end": 24.5,
      "text": " Bilmem.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 24.86,
      "end": 27.36,
      "text": " Doğru yönlendirilmiş günahların Azizi nasıl?",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 27.76,
      "end": 29.1,
      "text": " Evet, kısa süreliğine.",
      "no_speech_prob": 0.3541180193424225
    },
    {
      "start": 29.1,
      "end": 31.56,
      "text": " Bazı ideolojik anlaşmazlıklarım vardı.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 32.1,
      "end": 33.8,
      "text": " İnsan unsurunu göz ardı ediyordu.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 34.24,
      "end": 36.96,
      "text": " Evet, ama o konuyu düşünmeye bile yetkim yok.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 37.32,
      "end": 38.48,
      "text": " Parkour'da bol şans.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 38.76,
      "end": 39.94,
      "text": " Tanıştığımızda sevindim.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 40.12,
      "end": 41.2,
      "text": " Sam, Grimsdottir.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 41.44,
      "end": 43.56,
      "text": " Zıpla dersem ne kadar yükseğe diye sorma.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 43.76,
      "end": 44.4,
      "text": " Sadece yap.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 44.68,
      "end": 45.44,
      "text": " Bunu atlatırsın.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 45.72,
      "end": 47.2,
      "text": " Koridorun karşısında bir oda var.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 47.44,
      "end": 48.16,
      "text": " Hemen oraya git.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 48.52,
      "end": 49.64,
      "text": " Kahretsin, özür dilerim.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 49.92,
      "end": 51.82,
      "text": " Koridora dön, en uçtaki merdivene git.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 52.04,
      "end": 53.9,
      "text": " Çabuk ol, sadece birkaç saniyen var.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 54.16,
      "end": 55.46,
      "text": " Tanrım, ucuz atlattık.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 55.68,
      "end": 57.28,
      "text": " İlerden sola dön, odadan geç.",
      "no_speech_prob": 0.7005211710929871
    },
    {
      "start": 57.28,
      "end": 59.96,
      "text": " Karşı köşedeki merdiveni kullanıp en üst kata çık.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 60.36,
      "end": 61.4,
      "text": " Bağlantımız bu odada.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 61.64,
      "end": 63.1,
      "text": " Umarım hâlâ hayattadır.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 63.28,
      "end": 65.26,
      "text": " Odanın batı tarafında güvenli bir çıkış var.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 65.42,
      "end": 66.02,
      "text": " Orayı kullan.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 66.34,
      "end": 67.22,
      "text": " Duman çok yoğun.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 67.38,
      "end": 68.46,
      "text": " Tavan pencerelerini vur.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 68.76,
      "end": 69.66,
      "text": " İşte adamımız.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 69.9,
      "end": 70.98,
      "text": " Suçüstü yakaladık.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 71.16,
      "end": 71.92,
      "text": " Çoktan başladım.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 72.22,
      "end": 73.14,
      "text": " Bak bir plaka.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 73.42,
      "end": 75.6,
      "text": " 84 kp 214.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 75.84,
      "end": 77.02,
      "text": " Cam asansör hareket ediyor.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 77.4,
      "end": 77.92,
      "text": " İçerdeyim.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 78.18,
      "end": 79.16,
      "text": " İşte buldum.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 79.36,
      "end": 81.42,
      "text": " Sızıntı Mitchell Doherty adına kayıtlı,",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 81.6,
      "end": 83.36,
      "text": " düşük güvenlikli bir bilgisayardan geliyor.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 83.78,
      "end": 84.36,
      "text": " Üzerindeyim.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 84.48,
      "end": 85.9,
      "text": " Çok akıllıca bir arka kapı.",
      "no_speech_prob": 0.5555296540260315
    },
    {
      "start": 85.9,
      "end": 88.64,
      "text": " Filip Masen'in işi gibi. Bir sunucuya sıçrıyor.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 88.86,
      "end": 91.98,
      "text": " Servkalina Altire V. Bu da Kalina tek binası.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 92.34,
      "end": 95.36,
      "text": " Ah kahretsin! Biri beni fark etti. Sistemi kapattılar.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 95.6,
      "end": 98.86,
      "text": " Üçüncü katta paralı programcılardan bir grup hala hayatta.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 99.16,
      "end": 101.7,
      "text": " Ama yeni bir gelişme var. Güç şebekesine sızdım.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 101.94,
      "end": 105.0,
      "text": " Birisi yangın kapılarının devresindeki şalteri indirmiş.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 105.28,
      "end": 108.7,
      "text": " Bunun ne kadarını kullanabiliriz bilmiyorum. Çoğunu silmişler.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 109.12,
      "end": 109.96,
      "text": " Lambert, bir bak.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 110.34,
      "end": 114.48,
      "text": " Elçilik yeterince serinse tuş takımlarında kalan ısı farkını görebilirsin.",
      "no_speech_prob": 0.3914366662502289
    },
    {
      "start": 114.48,
      "end": 116.36,
      "text": " Termal gözlükleri kullan Fisher.",
      "no_speech_prob": 0.21512456238269806
    },
    {
      "start": 116.7,
      "end": 118.48,
      "text": " Tuşlarda kalan ısı izlerini görmelisin.",
      "no_speech_prob": 0.21512456238269806
    },
    {
      "start": 119.26,
      "end": 120.14,
      "text": " İşimize yarar.",
      "no_speech_prob": 0.21512456238269806
    },
    {
      "start": 120.44,
      "end": 124.48,
      "text": " Bu, Feiyong'un Çin hükümetinden bağımsız hareket ettiğini kesin olarak kanıtlıyor.",
      "no_speech_prob": 0.21512456238269806
    }
  ],
