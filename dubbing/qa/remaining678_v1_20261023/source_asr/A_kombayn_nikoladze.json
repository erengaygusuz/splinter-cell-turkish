  "segments": [
    {
      "start": 0.0,
      "end": 7.22,
      "text": " Hala ahlaki bir süper güç diye bir şey olduğuna inanan bir ulusun budalaca açgözlülüğü ve kibri.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 7.5,
      "end": 9.98,
      "text": " Hala böyle bir şey olduğuna inanan bir ulus,",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 10.22,
      "end": 12.14,
      "text": " hala böyle bir şey olduğuna inanan,",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 12.48,
      "end": 13.0,
      "text": " hala inanan,",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 13.8,
      "end": 14.86,
      "text": " hala inanan,",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 15.04,
      "end": 16.04,
      "text": " hala inanan.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 16.44,
      "end": 18.08,
      "text": " Grinko, ben Nikoladze.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 18.56,
      "end": 19.86,
      "text": " Amerikalı askerleri öldür.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 20.18,
      "end": 22.1,
      "text": " Onları stüdyoya götür ve infaz et.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 22.46,
      "end": 24.64,
      "text": " Görüntüleri fırsat bulur bulmaz yayınlarız.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 25.06,
      "end": 27.02,
      "text": " Fejronk, Aplan'a devam ettiğimizi söyle.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 27.34,
      "end": 28.3,
      "text": " Arkı ben alacağım.",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 28.62,
      "end": 29.44,
      "text": " Onu öldürdün mü?",
      "no_speech_prob": 0.08544319123029709
    },
    {
      "start": 29.44,
      "end": 33.4,
      "text": " Tanrım sen kimsin? Ne yapıyorsun? Benden ne istiyorsun?",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 33.96,
      "end": 35.92,
      "text": " Amerikalısın. Beni öldürmeye mi geldin?",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 36.26,
      "end": 40.74,
      "text": " Konuş benimle kahretsin. Sana istediğin her şeyi veririm. Yeter ki gitmeme izin ver.",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 41.0,
      "end": 43.16,
      "text": " Ne istiyorsun? Benden ne istiyorsun?",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 43.46,
      "end": 48.4,
      "text": " Peki o zaman sessizce bekleriz. Benim yardımım olmadan ölü bir adamsın.",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 48.6,
      "end": 52.62,
      "text": " Ona sor. Ben Tanrı değilim. Neden bahsettiğinizi gerçekten bilmiyorum.",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 53.04,
      "end": 57.32,
      "text": " Aaa akıllı adammış. Peki onun zaten Amerika'da olduğunu biliyor mu?",
      "no_speech_prob": 0.15147604048252106
    },
    {
      "start": 57.32,
      "end": 58.58,
      "text": " Ark burada değil.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 58.88,
      "end": 61.26,
      "text": " Bu kasadaki tek şey etkinleştirme anahtarı.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 61.58,
      "end": 63.16,
      "text": " Bombanın kendisi Amerika'da.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 63.42,
      "end": 66.86,
      "text": " Christa ve özgürlüğümü garanti ederse, Ark'ın yerini söylerim.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 67.18,
      "end": 68.4,
      "text": " Anahtar bu casusta.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 68.66,
      "end": 69.54,
      "text": " Bu Amerikalı'da.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 69.76,
      "end": 71.22,
      "text": " Ondan almak zorundasınız.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 71.46,
      "end": 72.82,
      "text": " Size yerini söyleyebilirim.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 73.02,
      "end": 76.08,
      "text": " Ama yalnızca güvenliğim ve özgürlüğüm garanti edilirse.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 76.44,
      "end": 77.62,
      "text": " Bir ay önce öyleydi.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 77.88,
      "end": 79.32,
      "text": " Bir kez ortadan kayboldum.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 79.52,
      "end": 81.1,
      "text": " Yine kolayca kaybolabilirim.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 81.28,
      "end": 81.84,
      "text": " Elbette.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 82.18,
      "end": 82.74,
      "text": " Merak etme.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 83.06,
      "end": 85.2,
      "text": " Eskortum gelir gelmez buradan ayrılacağım.",
      "no_speech_prob": 0.16454219818115234
    },
    {
      "start": 85.2,
      "end": 87.66,
      "text": " Tabii ARK konusunda anlaşmışsak.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 87.88,
      "end": 89.4,
      "text": " Pro'larından birini alabilir miyim?",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 89.74,
      "end": 90.6,
      "text": " Çok teşekkürler.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 90.9,
      "end": 95.84,
      "text": " Peki, düşmanlarının öldüğünü kanıtlayamadığı bir müttefikin değerine ne biçersin?",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 96.38,
      "end": 100.16,
      "text": " O halde ARK'ı dostlarına karşı bir tehdit olarak mı tutacaksın?",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 100.72,
      "end": 101.42,
      "text": " Ne derler?",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 101.78,
      "end": 104.18,
      "text": " Nükleer silahlar iyi komşuluk getirir.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 104.66,
      "end": 105.88,
      "text": " Şartlarımı biliyorsun.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 106.14,
      "end": 108.38,
      "text": " Güvenli geçiş ve Amerikan doları.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 108.5,
      "end": 109.92,
      "text": " İstediğim meblağ önünde.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 110.34,
      "end": 112.26,
      "text": " O halde ben de çıkışımı yaparım.",
      "no_speech_prob": 0.1875644475221634
    },
    {
      "start": 112.26,
      "end": 116.06,
      "text": " Para hesabıma geçtiğinde ARK'ın koordinatlarını sana gönderirim.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 116.46,
      "end": 118.28,
      "text": " Bu hayatta değil, bol şans.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 118.66,
      "end": 121.02,
      "text": " Gitmeme izin ver, seni zengin edebilirim.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 121.26,
      "end": 123.04,
      "text": " Bununla hiçbir yere varamazsın.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 123.44,
      "end": 123.74,
      "text": " Neyle?",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 124.14,
      "end": 126.18,
      "text": " Ya beni öldür ya da bırak gideyim.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 126.5,
      "end": 127.9,
      "text": " Yaptığının hiçbir anlamı yok.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 128.28,
      "end": 129.14,
      "text": " Bu çocukça.",
      "no_speech_prob": 0.060689281672239304
    },
    {
      "start": 129.38,
      "end": 130.6,
      "text": " Başka bir şey söylemeyeceğim.",
      "no_speech_prob": 0.060689281672239304
    }
  ],
