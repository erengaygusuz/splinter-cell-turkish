    },
    {
      "start": 4.66,
      "end": 6.86,
      "text": " Görev çok hassas. Kimse ölmemeli.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 7.24,
      "end": 9.76,
      "text": " Yaklaşınca Lambert bağlantımızın yerini verecek.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 10.16,
      "end": 12.42,
      "text": " Fark edilmemek için sürekli yer değiştiriyor.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 12.82,
      "end": 13.54,
      "text": " İyi şanslar.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 14.04,
      "end": 15.7,
      "text": " T-Man Wilkes için de başın sağ olsun.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 16.02,
      "end": 17.38,
      "text": " İyi bir adam olduğunu duydum.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 17.62,
      "end": 18.78,
      "text": " Umarım anlaşırız.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 18.98,
      "end": 21.88,
      "text": " Fort Taki dosyana göre bir kadınla çalışmak sana sorun değil.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 22.26,
      "end": 24.16,
      "text": " Evet, tabii. İyi şanslar.",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 24.48,
      "end": 25.5,
      "text": " Arkaya! Gidiyoruz!",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 25.88,
      "end": 26.6,
      "text": " Bir yere tutun!",
      "no_speech_prob": 0.048391859978437424
    },
    {
      "start": 26.6,
      "end": 30.2,
      "text": " Buraya kadar. Lambert, Fyrong'u ürkütmek istemiyor.",
      "no_speech_prob": 0.27907148003578186
