  "segments": [
    {
      "start": 0.0,
      "end": 3.02,
      "text": " Blaustein'ın çıkını çıkarırken biraz zorlandık.",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 3.22,
      "end": 5.26,
      "text": " Hala üzerinde kas dokusu lifleri var.",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 5.8,
      "end": 8.98,
      "text": " Ellerine kan bulaşmasın istiyorsan yanlış işi seçmişsin.",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 9.38,
      "end": 13.22,
      "text": " Sen sadece bir araçsın. Öyle mi? Temiz.",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 13.4,
      "end": 15.38,
      "text": " Alarm! Herkes tam alarma geçsin!",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 15.66,
      "end": 18.0,
      "text": " Nikoladze'nin ofisinde bir davetsiz misafir var!",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 18.36,
      "end": 20.38,
      "text": " Uyanın lan! Oraya hemen asker istiyorum!",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 20.82,
      "end": 23.66,
      "text": " Durum raporu istiyorum! Bu adam neden hala yakalanmadı?",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 23.96,
      "end": 25.42,
      "text": " Arka merdivende adamımız var mı?",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 25.8,
      "end": 28.14,
      "text": " Odada kimliği ele verecek ne varsa kaldırın.",
      "no_speech_prob": 0.05728882551193237
    },
    {
      "start": 28.14,
      "end": 31.74,
      "text": " Işıkları duvarlara vurmayın. Yüzlerini daha güçlü aydınlatın.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 31.94,
      "end": 34.14,
      "text": " Ölürlerken yüzlerini net görmemiz gerek.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 34.46,
      "end": 35.22,
      "text": " Sesçimiz nerede?",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 35.62,
      "end": 37.66,
      "text": " Dualarını duyacak kadar yakından kayıtalım.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 38.08,
      "end": 41.06,
      "text": " Nikoladze'yi buradan çıkarın. Helikopteri hemen havalansın.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 41.28,
      "end": 45.08,
      "text": " Silahlı eskortla bir teknisyen ekibini çatıya gönderin, o anteni onarsınlar.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 45.5,
      "end": 47.22,
      "text": " Amerikalıları bulun ve öldürün!",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 47.64,
      "end": 48.56,
      "text": " Grinko konuşuyor.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 48.94,
      "end": 51.48,
      "text": " Amerikalı askerleri hazırlayın ve stüdyoya götürün.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 51.68,
      "end": 53.78,
      "text": " İnfazlar planlandığı gibi devam edecek.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 54.22,
      "end": 56.64,
      "text": " Kahretsin! Amerikalılar Bodrum'u ele geçirdi.",
      "no_speech_prob": 0.4051329493522644
    },
    {
      "start": 56.64,
      "end": 60.42,
      "text": " Silah tutabilen herkes Bodrum'da toplansın, hepsini öldüreceğiz!",
      "no_speech_prob": 0.6348413825035095
    },
    {
      "start": 60.86,
      "end": 63.26,
      "text": " Albay Bagrat, rapor ver! Albay Bagrat!",
      "no_speech_prob": 0.6348413825035095
    },
    {
      "start": 63.6,
      "end": 65.14,
      "text": " Kahretsin! Aşağı iniyorum!",
      "no_speech_prob": 0.6348413825035095
    },
    {
      "start": 65.4,
      "end": 66.74,
      "text": " Nosenko, benimle geliyorsun!",
      "no_speech_prob": 0.6348413825035095
    }
  ],
