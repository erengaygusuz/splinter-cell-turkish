    {
      "start": 0.0,
      "end": 1.18,
      "text": " Bu o olmalı.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 1.44,
      "end": 4.4,
      "text": " Hey! Yaptıkların hakkında acayip şeyler duydum.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 4.62,
      "end": 6.32,
      "text": " Aynen, kesinlikle.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 6.6,
      "end": 9.06,
      "text": " Adamım, sahaya dönmek için can atıyorsundur ha?",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 9.36,
      "end": 10.62,
      "text": " İhtiyacımız olan da bu.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 10.98,
      "end": 12.14,
      "text": " NCA'ya hoş geldin.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 12.44,
      "end": 13.48,
      "text": " Orada ne buldun öyle?",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 13.86,
      "end": 15.24,
      "text": " Lambert resmen çıldırıyor.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 15.64,
      "end": 16.54,
      "text": " Savaşa gidiyoruz.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 17.0,
      "end": 19.44,
      "text": " Şükürler olsun, hiç gitmeyecek sandım.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 19.64,
      "end": 20.66,
      "text": " Evet, bu o.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 20.88,
      "end": 21.48,
      "text": " Doggarty nerede?",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 21.92,
      "end": 24.26,
      "text": " Lambert şu kalinat ekişi yüzünden çıldırıyor.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 24.66,
      "end": 27.06,
      "text": " Şükürler olsun, hiç gitmeyecek sandım.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 27.28,
      "end": 28.28,
      "text": " Evet, bu o.",
      "no_speech_prob": 0.23202437162399292
    },
    {
      "start": 28.28,
      "end": 29.98,
      "text": " Nadiren, ama evet.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 30.42,
      "end": 31.66,
      "text": " Sorbu için demek istiyor.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 31.96,
      "end": 33.1,
      "text": " İnsanları konuşturmak için.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 33.54,
      "end": 36.08,
      "text": " Şu şeyin adı neydi? Pento bir şey.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 36.46,
      "end": 37.82,
      "text": " Bu bayağı ürkütücü.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 38.08,
      "end": 38.82,
      "text": " Takma kafana.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 39.22,
      "end": 40.88,
      "text": " Kahretsin! Biri onu durdursun!",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 41.26,
      "end": 43.04,
      "text": " Lambert sana Sarah'dan bahsetti mi?",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 43.28,
      "end": 43.76,
      "text": " O iyi.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 44.04,
      "end": 46.8,
      "text": " Elektrik kesintisi onu korkuttu ama hiçbir şeyi yok.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 47.18,
      "end": 48.34,
      "text": " Fazla duygusallaşma.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 48.58,
      "end": 49.4,
      "text": " Hadi çıkalım buradan.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 49.74,
      "end": 50.9,
      "text": " Daha fazla yaklaşamayız.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 51.12,
      "end": 52.0,
      "text": " Ayrıntılar tamam mı?",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 52.24,
      "end": 53.96,
      "text": " Bu son dakika işleri beni geriyor.",
      "no_speech_prob": 0.06254853308200836
    },
    {
      "start": 54.32,
      "end": 55.52,
      "text": " Peki, dikkatli ol.",
      "no_speech_prob": 0.06254853308200836
    }
  ],
