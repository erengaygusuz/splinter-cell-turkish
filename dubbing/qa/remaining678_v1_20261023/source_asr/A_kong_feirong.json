  "segments": [
    {
      "start": 0.0,
      "end": 1.32,
      "text": " Bana 3 gün daha ver.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 1.7,
      "end": 4.76,
      "text": " Cihazlar bir günde hazırlanır, ertesi gün yerleştirilir.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 5.12,
      "end": 5.78,
      "text": " Elbette Ark.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 6.18,
      "end": 7.62,
      "text": " Ama ayrıntıları biliyorsun.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 7.82,
      "end": 8.82,
      "text": " Birlikte vurmalıyız.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 8.94,
      "end": 10.62,
      "text": " Yoksa hiç vurmayalım daha iyi.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 10.92,
      "end": 12.22,
      "text": " Nikoladze, beni dinle.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 12.42,
      "end": 13.42,
      "text": " Bizi ele vereceksin.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 13.72,
      "end": 14.58,
      "text": " Bu saçmalık.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 14.7,
      "end": 15.74,
      "text": " Nasıl dinleyebilirler?",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 15.94,
      "end": 16.98,
      "text": " Bu paranoia ama.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 17.24,
      "end": 18.16,
      "text": " Peki, peki.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 18.36,
      "end": 18.58,
      "text": " Tamam.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 18.82,
      "end": 20.2,
      "text": " Güvenli bir konuşma yaparız.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 20.4,
      "end": 21.7,
      "text": " Seni arabamdan geri ararım.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 22.04,
      "end": 24.54,
      "text": " Dinlemesinden endişe ettiğim yalnızca onlar değil.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 24.88,
      "end": 26.72,
      "text": " Sadece en yeteneklileri onlar.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 27.12,
      "end": 27.72,
      "text": " Elbette.",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 27.92,
      "end": 29.44,
      "text": " Sinyal kaç kez yönlendirilecek?",
      "no_speech_prob": 0.1632246971130371
    },
    {
      "start": 29.44,
      "end": 32.74,
      "text": " Kola Yarımadası'ndaki üstsünün de izlenemeyeceğine inanıyordun.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 32.92,
      "end": 34.36,
      "text": " Savaş psikolojisini bilirim.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 34.66,
      "end": 36.58,
      "text": " Evet evet birçok infaz gördüm.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 36.76,
      "end": 38.5,
      "text": " Ama hiç Amerikalıların kini değil.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 38.82,
      "end": 39.46,
      "text": " Bir saniye.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 39.52,
      "end": 40.02,
      "text": " Şoför.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 40.2,
      "end": 42.24,
      "text": " Moketsue Bo Meats ne kadar uzakta?",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 42.48,
      "end": 44.08,
      "text": " Hayır zahmete değmez.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 44.36,
      "end": 46.02,
      "text": " Yayını herkes gibi izlerim.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 46.6,
      "end": 47.78,
      "text": " Evet çok doğru.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 48.58,
      "end": 50.74,
      "text": " Ne kadar kötü bir adamsınız Bay Nikoladze.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 51.02,
      "end": 52.56,
      "text": " Umarım gösteriniz iyi geçer.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 52.84,
      "end": 53.64,
      "text": " Kendinize iyi bakın.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 53.96,
      "end": 55.14,
      "text": " Kong Feiron konuşuyor.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 55.3,
      "end": 57.36,
      "text": " Tüm birliklere kırmızı durum emrini iletin.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 57.62,
      "end": 58.36,
      "text": " Tekrar ediyorum.",
      "no_speech_prob": 0.14492680132389069
    },
    {
      "start": 58.36,
      "end": 64.16,
      "text": " Kırmızı durum. Nikolatze bizi terk etti. Herkes tam alarma geçsin. Konvoyu harekete hazır istiyorum.",
      "no_speech_prob": 0.18511545658111572
    },
    {
      "start": 64.66,
      "end": 69.74,
      "text": " Kendimi vuracağım. Çin özel kuvvetleri benim için geliyor. Bir ceset bulmalarını istiyorum.",
      "no_speech_prob": 0.18511545658111572
    },
    {
      "start": 70.16,
      "end": 72.94,
      "text": " Amerikalılarla barışın yolunu açan anahtar olmayacağım.",
      "no_speech_prob": 0.18511545658111572
    },
    {
      "start": 73.26,
      "end": 79.78,
      "text": " Bir şişe zehri, büyük elçinin iyi içkisinden bir şişeyle içip bitirdim. Ama bir asker gibi örneği tercih ederim.",
      "no_speech_prob": 0.18511545658111572
    },
    {
      "start": 80.06,
      "end": 86.88,
      "text": " Bu iyiliği bana yap. Çin güçlü. Cumhuriyet güçlü. Savaşa girmesi için yalnızca biraz itirmesi gerekiyor.",
      "no_speech_prob": 0.18511545658111572
    },
    {
      "start": 86.88,
      "end": 90.06,
      "text": " İmparatorluk, Tayvan, birazcık itmek yeter.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 90.4,
      "end": 93.48,
      "text": " Nikoladze beni terk etti, kaçtı, zayıf.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 93.66,
      "end": 96.58,
      "text": " Hadi Amerikalı, biz bir imparatorluğuz.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 96.88,
      "end": 99.16,
      "text": " Öldür beni, öldür beni korkak.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 99.46,
      "end": 101.72,
      "text": " Bizim savaşımız da gelecek, vur beni.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 101.98,
      "end": 103.9,
      "text": " Zaten ölüyüm, cehenneme git.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 104.06,
      "end": 106.28,
      "text": " Ölü bir adama hiçbir şey yaptıramazsın.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 106.54,
      "end": 108.96,
      "text": " Ben sen gelmeden çok önce acı çekiyordum.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 109.3,
      "end": 111.42,
      "text": " Elinden gelenin en kötüsünü yap.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 111.86,
      "end": 113.84,
      "text": " Bilmiyorum, umrumda da değil.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 114.16,
      "end": 116.52,
      "text": " Umarım onu bulur ve öldürürsün.",
      "no_speech_prob": 0.15874174237251282
    },
    {
      "start": 116.52,
      "end": 118.3,
      "text": " Ama nerde olduğunu bilmiyorum.",
      "no_speech_prob": 0.01331244595348835
    },
    {
      "start": 118.88,
      "end": 121.48,
      "text": " Sen ve faşist hükümetin cehenneme gidin.",
      "no_speech_prob": 0.01331244595348835
    },
    {
      "start": 121.68,
      "end": 122.98,
      "text": " Öldür beni Amerikalı.",
      "no_speech_prob": 0.01331244595348835
    },
    {
      "start": 123.38,
      "end": 124.74,
      "text": " İkimize de bir iyilik yap.",
      "no_speech_prob": 0.01331244595348835
    }
  ],
