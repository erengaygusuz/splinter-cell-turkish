    {
      "start": 0.0,
      "end": 2.28,
      "text": "Third Echelon'un baş programcısı."
    },
    {
      "start": 2.68,
      "end": 3.84,
      "text": "Sakın söyleme."
    },
    {
      "start": 4.1,
      "end": 5.58,
      "text": "Gurgenidze içeride, değil mi?"
    },
    {
      "start": 5.98,
      "end": 7.72,
      "text": "Blaustein ve Madison'ı buldum."
    },
    {
      "start": 8.12,
