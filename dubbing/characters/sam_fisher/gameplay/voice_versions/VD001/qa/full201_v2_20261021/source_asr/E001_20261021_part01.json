    },
    {
      "start": 19.34,
      "end": 20.82,
      "text": "Wilkes konusunu bir daha açma."
    },
    {
      "start": 21.34,
      "end": 22.46,
      "text": "Moke Tsoe Bo."
    },
    {
      "start": 22.98,
      "end": 24.46,
