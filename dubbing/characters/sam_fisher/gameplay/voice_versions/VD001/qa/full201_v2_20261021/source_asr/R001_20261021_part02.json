  "segments": [
    {
      "start": 0.0,
      "end": 2.58,
      "text": "Yüze değil, sırada general var."
    },
    {
      "start": 3.06,
      "end": 4.86,
      "text": "Bu işte çok intihar görüyorum."
    },
    {
      "start": 5.14,
      "end": 8.86,
      "text": "Bilgisayarındaki verilerin kilidini açacağım, sen de bana yardım edeceksin."
    },
    {
      "start": 9.38,
      "end": 10.24,
      "text": "Henüz ölmedin."
    },
    {
      "start": 10.5,
      "end": 12.82,
      "text": "Elinde kalan tek şey hayatının geri kalanı."
    },
    {
      "start": 13.26,
      "end": 15.74,
      "text": "Ne kadar acı çekeceğin işbirliğine bağlı."
    },
    {
      "start": 15.96,
      "end": 17.1,
      "text": "Hmm, olur."
    },
    {
      "start": 17.64,
      "end": 18.88,
      "text": "Nikoladze nereye kaçtı?"
    },
    {
      "start": 19.26,
      "end": 20.94,
      "text": "O adama sadakat borcun yok."
    },
    {
      "start": 21.26,
      "end": 22.96,
      "text": "Kaçtı, sana ihanet etti."
    },
    {
      "start": 23.36,
      "end": 24.06,
      "text": "Ne buldun?"
    },
    {
      "start": 24.24,
      "end": 25.46,
      "text": "Ne? Ne dedin?"
    },
    {
      "start": 25.84,
      "end": 28.06,
      "text": "Yani bavul tipi bir nükleer bomba."
    },
    {
      "start": 28.06,
      "end": 31.66,
      "text": "Yani Ark'ı almak için Nikoladze'yi canlı tutmam gerekecek."
    },
    {
      "start": 31.98,
      "end": 33.36,
      "text": "Bunlar saray muhafızları değil."
    },
    {
      "start": 33.76,
      "end": 34.92,
      "text": "Bir tür özel kuvvet."
    },
    {
      "start": 35.18,
      "end": 36.2,
      "text": "Planım değişiyor mu?"
    },
    {
      "start": 36.4,
      "end": 38.12,
      "text": "Ark'ın yerini gerçekten biliyor mu?"
    },
    {
      "start": 38.48,
      "end": 40.18,
      "text": "Combine Nikoladze'yi öldürdüm."
    },
    {
      "start": 40.46,
      "end": 41.4,
      "text": "Neyin sonuncusu?"
    },
    {
      "start": 41.66,
      "end": 42.36,
      "text": "Ark'ı anlat."
    },
    {
      "start": 42.8,
      "end": 43.88,
      "text": "Ne olduğunu biliyorum."
    },
    {
      "start": 44.2,
      "end": 45.6,
      "text": "Nereden geldiğini bilmek istiyorum."
    },
    {
      "start": 46.1,
      "end": 46.96,
      "text": "Onunla ne yapacaksın?"
    },
    {
      "start": 47.4,
      "end": 47.82,
      "text": "Ark."
    },
    {
      "start": 48.1,
      "end": 49.02,
      "text": "Nerede patlatacaksın?"
    },
    {
      "start": 49.44,
      "end": 50.14,
      "text": "Ark'ı anlat."
    }
  ],
