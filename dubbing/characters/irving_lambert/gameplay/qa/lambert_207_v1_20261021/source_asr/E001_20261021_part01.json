  "segments": [
    {
      "start": 0.0,
      "end": 2.94,
      "text": "Pekala Sam, başlayalım. Beni net duyuyor musun?"
    },
    {
      "start": 3.46,
      "end": 7.0,
      "text": "Cesedi yangına bırak. Ailesine açıklanacak daha az şey kalır."
    },
    {
      "start": 7.46,
      "end": 9.1,
      "text": "Ucuz atlattın. Yaşıyor musun?"
    },
    {
      "start": 9.56,
      "end": 12.02,
      "text": "Blaustein'in kalbi 43 saat önce durdu."
    },
    {
      "start": 12.44,
      "end": 13.78,
      "text": "Lazer mikrofonu kullan, Fisher."
    },
    {
      "start": 14.28,
      "end": 17.82,
      "text": "Grinko ile Masse yukarı varmadan ne konuştuklarını duymamız kritik."
    },
    {
      "start": 18.22,
      "end": 20.82,
      "text": "Kötü haber, Fisher. Bir şey ordunun dikkatini çekti."
    },
    {
      "start": 21.2,
      "end": 24.62,
      "text": "Kahretsin, Fisher. Seni bu işi aldırmak için boynuma ortaya koydum."
    },
    {
      "start": 24.86,
      "end": 29.12,
      "text": "Aklından ne geçiyordu? Kovuldun. Ajansla işim bitti. Oyun bitti."
    },
    {
      "start": 29.12,
      "end": 32.16,
      "text": "Sorgu, işkence ve aman tanrım!"
    },
    {
      "start": 32.42,
      "end": 36.38,
      "text": "Konuşma Fischer, 5 saniye içinde elektrikleri keseceğiz. İyi değerlendir."
    },
    {
      "start": 36.7,
      "end": 40.52,
      "text": "İyi iş Fischer, şimdi ortadan kaybol. Taşıdığın veri bunun sonuncusu."
    }
  ],
